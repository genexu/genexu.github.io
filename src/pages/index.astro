---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { DEFAULT_SITE_TITLE, DEFAULT_SITE_DESCRIPTION } from "../constants";
import Layout from "../layouts/Layout.astro";
import PostCard from "../components/PostCard.astro";
import ReadingCarousel from "../components/ReadingCarousel.astro";
import { deconstructSlug, getPostsByLang } from "../i18n/utils";

const lang = Astro.currentLocale;

const allPosts = await getCollection("blog");
const allLife = await getCollection("life");
const allReading = await getCollection("reading");
const allNotes = await getCollection("notes");

const posts = getPostsByLang(allPosts, lang);
const life = getPostsByLang(allLife, lang);
const reading = getPostsByLang(allReading, lang);
const notes = getPostsByLang(allNotes, lang);

const byDate = (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
const recentPosts = posts.sort(byDate).slice(0, 3);
const recentLife = life.sort(byDate).slice(0, 3);
const recentReading = reading.sort(byDate).slice(0, 3);
const recentNotes = notes.sort(byDate).slice(0, 3);

const decoratePost = (post) => {
	const { lang: slugLang, slugWithoutLang } = deconstructSlug(post.id);
	return {
		...post,
		params: {
			slug: slugWithoutLang,
			lang,
			isLanguageNotSupported: slugLang !== lang,
		},
	};
};

const t = {
	en: {
		writing: "Writing",
		reading: "Reading",
		life: "Life",
		notes: "Notes",
		all: "All",
	},
	'zh-tw': {
		writing: "文章",
		reading: "閱讀",
		life: "生活",
		notes: "筆記",
		all: "全部",
	},
}[lang] || {
	writing: "Writing", reading: "Reading", life: "Life", notes: "Notes", all: "All",
};
---

<Layout title={DEFAULT_SITE_TITLE} description={DEFAULT_SITE_DESCRIPTION}>
	<div class="max-w-3xl mx-auto">
		{recentReading.length > 0 && (
			<section class="pt-10 md:pt-12">
				<header class="flex items-baseline justify-between mb-6">
					<h2 class="font-display text-xl text-ink">{t.reading}</h2>
					<a
						href={getRelativeLocaleUrl(lang, 'reading')}
						class="eyebrow text-moss hover:text-rust transition-colors"
					>
						{t.all} →
					</a>
				</header>
				<div class="px-4 md:px-6">
					<ReadingCarousel posts={recentReading.map((post) => decoratePost(post))} />
				</div>
			</section>
		)}

		{recentPosts.length > 0 && (
			<>
				<hr class="kintsugi" aria-hidden="true" />
				<section>
					<header class="flex items-baseline justify-between mb-6">
						<h2 class="font-display text-xl text-ink">{t.writing}</h2>
						<a
							href={getRelativeLocaleUrl(lang, 'blog')}
							class="eyebrow text-moss hover:text-rust transition-colors"
						>
							{t.all} →
						</a>
					</header>
					<div>
						{recentPosts.map((post) => (
							<PostCard post={decoratePost(post)} />
						))}
					</div>
				</section>
			</>
		)}

		{recentLife.length > 0 && (
			<>
				<hr class="kintsugi" aria-hidden="true" />
				<section>
					<header class="flex items-baseline justify-between mb-6">
						<h2 class="font-display text-xl text-ink">{t.life}</h2>
						<a
							href={getRelativeLocaleUrl(lang, 'life')}
							class="eyebrow text-moss hover:text-rust transition-colors"
						>
							{t.all} →
						</a>
					</header>
					<div>
						{recentLife.map((post) => (
							<PostCard post={decoratePost(post)} />
						))}
					</div>
				</section>
			</>
		)}

		{recentNotes.length > 0 && (
			<>
				<hr class="kintsugi" aria-hidden="true" />
				<section>
					<header class="flex items-baseline justify-between mb-6">
						<h2 class="font-display text-xl text-ink">{t.notes}</h2>
						<a
							href={getRelativeLocaleUrl(lang, 'notes')}
							class="eyebrow text-moss hover:text-rust transition-colors"
						>
							{t.all} →
						</a>
					</header>
					<div>
						{recentNotes.map((note) => (
							<PostCard post={decoratePost(note)} />
						))}
					</div>
				</section>
			</>
		)}
	</div>
</Layout>
