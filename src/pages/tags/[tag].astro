---
import { getCollection, type CollectionEntry } from "astro:content";
import ListingLayout from "../../layouts/ListingLayout.astro";
import PostCard from "../../components/PostCard.astro";
import ReadingCard from "../../components/ReadingCard.astro";
import { deconstructSlug, getPostsByLang, slugifyTag } from "../../i18n/utils";

type TaggablePost = CollectionEntry<"blog" | "notes" | "life" | "reading">;

export async function getStaticPaths() {
	const [blog, notes, life, reading] = await Promise.all([
		getCollection("blog"),
		getCollection("notes"),
		getCollection("life"),
		getCollection("reading"),
	]);
	const allPosts: TaggablePost[] = [...blog, ...notes, ...life, ...reading];

	// Group posts by slugified tag; keep original text for display.
	const bySlug = new Map<string, { display: string; posts: TaggablePost[] }>();
	for (const post of allPosts) {
		for (const tag of post.data.tags ?? []) {
			const slug = slugifyTag(tag);
			const entry = bySlug.get(slug) ?? { display: tag, posts: [] };
			entry.posts.push(post);
			bySlug.set(slug, entry);
		}
	}

	return Array.from(bySlug.entries()).map(([slug, { display, posts }]) => {
		const sorted = [...posts].sort(
			(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
		);
		return {
			params: { tag: slug },
			props: { displayTag: display, posts: sorted },
		};
	});
}

const { posts, displayTag } = Astro.props;

const lang = Astro.currentLocale;
const postsByLang = getPostsByLang(posts, lang);

const decoratedPosts = postsByLang.map((post) => {
	const { slugWithoutLang } = deconstructSlug(post.id);
	return {
		...post,
		params: {
			slug: slugWithoutLang,
			lang,
		},
	};
});

const content = {
	en: {
		title: "Posts",
	},
	"zh-tw": {
		title: "文章",
	},
};

const t = content[lang] || content.en;
---

<ListingLayout title={t.title} tag={displayTag}>
	<div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
		{decoratedPosts.map((post) => (
			post.collection === "reading"
				? <ReadingCard post={post} />
				: <PostCard post={post} />
		))}
	</div>
</ListingLayout>
