---
import { getRelativeLocaleUrl } from "astro:i18n";
import FormattedDateTime from "./FormattedDateTime.astro";
import { slugifyTag } from "../i18n/utils";
import type { CollectionEntry } from "astro:content";

type Post = CollectionEntry<"blog" | "notes" | "life"> & {
	params: {
		lang: string;
		slug: string;
	};
};

interface Props {
	post: Post;
}

const { post } = Astro.props;
const { data, params, collection } = post;
const { lang, slug } = params;
const { title, description, tags, pubDate, cover } = data;

const postUrl = getRelativeLocaleUrl(lang, `${collection}/${slug}`);
---

<article class="group py-6 border-b border-mist/40 last:border-b-0">
	<a href={postUrl} class="grid grid-cols-1 md:grid-cols-[1fr_auto] gap-x-6 gap-y-3 items-start">
		<div class="space-y-2 min-w-0">
			<div class="flex items-center gap-3 eyebrow">
				<FormattedDateTime datetime={pubDate} lang={lang} />
				<span class="text-mist/60">/</span>
				<span>{tags.length > 0 ? tags[0] : collection}</span>
			</div>

			<h2 class="font-display text-2xl leading-snug text-ink group-hover:text-rust transition-colors">
				{title}
			</h2>

			<p class="text-base text-ink-soft leading-relaxed line-clamp-2">
				{description}
			</p>
		</div>

		{cover && (
			<div class="order-first md:order-none w-full md:w-40 md:h-24 aspect-[3/2] overflow-hidden">
				<img
					src={cover}
					alt={title}
					loading="lazy"
					class="w-full h-full object-cover grayscale-[15%] group-hover:grayscale-0 transition-all duration-500"
				/>
			</div>
		)}
	</a>

	{tags.length > 0 && (
		<div class="mt-3 flex flex-wrap gap-x-3 gap-y-1 eyebrow">
			{tags.slice(0, 4).map((tag) => (
				<a
					href={getRelativeLocaleUrl(lang, `tags/${slugifyTag(tag)}`)}
					class="text-moss hover:text-rust transition-colors"
				>
					· {tag}
				</a>
			))}
			{tags.length > 4 && (
				<span class="text-mist/70">+{tags.length - 4}</span>
			)}
		</div>
	)}
</article>
