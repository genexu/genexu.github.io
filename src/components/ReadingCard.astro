---
import { getRelativeLocaleUrl } from "astro:i18n";
import FormattedDateTime from "./FormattedDateTime.astro";
import type { CollectionEntry } from "astro:content";

type ReadingPost = CollectionEntry<"reading"> & {
	params: {
		lang: string;
		slug: string;
	};
};

interface Props {
	post: ReadingPost;
	variant?: "vertical" | "horizontal";
}

const { post, variant = "vertical" } = Astro.props;
const { data, params, collection } = post;
const { lang, slug } = params;
const { title, description, author, rating, cover, pubDate } = data;

const postUrl = getRelativeLocaleUrl(lang, `${collection}/${slug}`);

const fullStars = Math.floor(rating);
const hasHalfStar = rating % 1 !== 0;
const stars = Array.from({ length: 5 }, (_, i) => {
	if (i < fullStars) return 'full';
	if (i === fullStars && hasHalfStar) return 'half';
	return 'empty';
});

const isHorizontal = variant === "horizontal";
---

<article class:list={["group", isHorizontal && "py-6 border-b border-mist/40 last:border-b-0"]}>
	<a
		href={postUrl}
		class:list={[
			isHorizontal
				? "flex flex-col gap-4 md:grid md:grid-cols-[auto_1fr] md:gap-6 md:items-start md:min-h-[210px]"
				: "flex flex-col gap-4"
		]}
	>
		<div class:list={[
			"overflow-hidden ring-1 ring-ink/10 md:self-start",
			isHorizontal && "md:h-[210px]"
		]}>
			{cover ? (
				<img
					src={cover}
					alt={`Cover of ${title}`}
					loading="lazy"
					class:list={[
						"grayscale-[15%] group-hover:grayscale-0 transition-all duration-500 block",
						isHorizontal ? "w-full h-auto md:w-auto md:h-full" : "w-full h-auto"
					]}
				/>
			) : (
				<div class:list={[
					"bg-paper-sunk flex items-center justify-center aspect-[2/3]",
					isHorizontal ? "w-full md:w-[140px] md:h-full md:aspect-auto" : "w-full"
				]}>
					<span class:list={["font-display text-mist", isHorizontal ? "text-xl" : "text-3xl"]}>冊</span>
				</div>
			)}
		</div>

		<div class="space-y-2 min-w-0">
			<h3 class:list={[
				"font-display leading-tight text-ink group-hover:text-rust transition-colors",
				isHorizontal ? "text-xl md:text-2xl" : "text-lg md:text-xl"
			]}>
				{title}
			</h3>
			<p class="text-sm text-ink-soft italic">
				<span class="not-italic text-mist">—</span> {author}
			</p>

			<div class="flex items-center gap-2">
				<div class="flex items-center gap-0.5">
					{stars.map((type) => (
						type === 'half' ? (
							<span class="relative inline-block w-3 h-3">
								<svg class="absolute inset-0 w-3 h-3 text-mist/50" fill="currentColor" viewBox="0 0 24 24">
									<path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
								</svg>
								<svg class="absolute inset-0 w-3 h-3 text-moss" fill="currentColor" viewBox="0 0 24 24" style="clip-path: inset(0 50% 0 0);">
									<path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
								</svg>
							</span>
						) : (
							<svg
								class:list={[
									"w-3 h-3",
									type === 'full' ? "text-moss fill-current" : "text-mist/50 fill-current"
								]}
								viewBox="0 0 24 24"
							>
								<path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
							</svg>
						)
					))}
				</div>
				<span class="eyebrow">
					<FormattedDateTime datetime={pubDate} lang={lang} />
				</span>
			</div>

			<p class:list={[
				"text-sm text-ink-soft leading-relaxed pt-1",
				isHorizontal ? "line-clamp-3" : "line-clamp-2"
			]}>
				{description}
			</p>
		</div>
	</a>
</article>
