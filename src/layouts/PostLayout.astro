---
import Head from "./Head.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import FormattedDateTime from "../components/FormattedDateTime.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { slugifyTag } from "../i18n/utils";

import "../styles/global.css";

const { frontmatter } = Astro.props;
const lang = Astro.currentLocale;

const { title, description, pubDate, tags } = frontmatter;
const datetime = new Date(pubDate);

const pathname = Astro.url.pathname;
const collection = pathname.includes('/blog/') ? 'blog' : pathname.includes('/notes/') ? 'notes' : pathname.includes('/life/') ? 'life' : '';

const breadcrumbs = {
	en: { home: 'Home', blog: 'Blog', notes: 'Notes', life: 'Life' },
	'zh-tw': { home: '首頁', blog: '文章', notes: '筆記', life: '生活' },
};

const t = breadcrumbs[lang] || breadcrumbs.en;
---

<!doctype html>
<html lang={lang}>
	<head>
		<Head title={title} description={description} />
	</head>
	<body class="min-h-screen bg-paper text-ink font-serif antialiased">
		<Header />
		<main class="container mx-auto px-6 md:px-10 lg:px-12">
			<article class="max-w-3xl mx-auto py-10 md:py-16" data-pagefind-body>
				<nav class="flex items-center gap-2 eyebrow mb-10">
					<a href={getRelativeLocaleUrl(lang, '')} class="hover:text-rust transition-colors">
						{t.home}
					</a>
					<span class="text-mist/60">/</span>
					{collection && (
						<>
							<a href={getRelativeLocaleUrl(lang, collection)} class="hover:text-rust transition-colors">
								{t[collection]}
							</a>
							<span class="text-mist/60">/</span>
						</>
					)}
				</nav>

				<header class="mb-4 space-y-6">
					<div class="space-y-4">
						<h1 class="font-display text-3xl md:text-4xl leading-[1.15] text-ink">
							{title}
						</h1>
						<p class="text-lg text-ink-soft leading-relaxed">
							{description}
						</p>
					</div>

					<div class="flex flex-wrap items-center gap-x-4 gap-y-2 eyebrow">
						<FormattedDateTime datetime={datetime} lang={lang} />
						{tags && tags.length > 0 && (
							<>
								<span class="text-mist/60">/</span>
								<div class="flex flex-wrap gap-x-3">
									{tags.map((tag) => (
										<a
											href={getRelativeLocaleUrl(lang, `tags/${slugifyTag(tag)}`)}
											class="text-moss hover:text-rust transition-colors"
										>
											· {tag}
										</a>
									))}
								</div>
							</>
						)}
					</div>
				</header>

				<hr class="kintsugi" aria-hidden="true" />

				<div class="prose prose-lg max-w-none">
					<slot />
				</div>

				<hr class="kintsugi" aria-hidden="true" />

				<div class="mt-8">
					<a
						href={getRelativeLocaleUrl(lang, collection)}
						class="inline-flex items-center gap-2 font-display text-ink-soft hover:text-rust transition-colors group"
					>
						<svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16l-4-4m0 0l4-4m-4 4h18"></path>
						</svg>
						{lang === 'zh-tw' ? `返回${t[collection] || ''}` : `Back to ${t[collection] || 'Home'}`}
					</a>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
