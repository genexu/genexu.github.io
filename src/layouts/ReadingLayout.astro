---
import Head from "./Head.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import FormattedDateTime from "../components/FormattedDateTime.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { slugifyTag } from "../i18n/utils";

import "../styles/global.css";

const { frontmatter } = Astro.props;
const lang = Astro.currentLocale;

const { title, description, author, rating, cover, pubDate, tags } = frontmatter;
const datetime = new Date(pubDate);

const fullStars = Math.floor(rating);
const hasHalfStar = rating % 1 !== 0;
const stars = Array.from({ length: 5 }, (_, i) => {
	if (i < fullStars) return 'full';
	if (i === fullStars && hasHalfStar) return 'half';
	return 'empty';
});

const t = {
	en: { home: 'Home', reading: 'Reading', reflection: 'Reading Reflection', back: 'Back to Reading' },
	'zh-tw': { home: '首頁', reading: '閱讀', reflection: '閱讀札記', back: '返回閱讀' },
}[lang] || {
	home: 'Home', reading: 'Reading', reflection: 'Reading Reflection', back: 'Back to Reading',
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<Head title={title} description={description} />
	</head>
	<body class="min-h-screen bg-paper text-ink font-serif antialiased">
		<Header />
		<main class="container mx-auto px-6 md:px-10 lg:px-12">
			<article class="max-w-4xl mx-auto py-10 md:py-16" data-pagefind-body>
				<nav class="flex items-center gap-2 eyebrow mb-10">
					<a href={getRelativeLocaleUrl(lang, '')} class="hover:text-rust transition-colors">
						{t.home}
					</a>
					<span class="text-mist/60">/</span>
					<a href={getRelativeLocaleUrl(lang, 'reading')} class="hover:text-rust transition-colors">
						{t.reading}
					</a>
					<span class="text-mist/60">/</span>
				</nav>

				<div class="mb-4">
					<div class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-8 md:gap-12 items-start">
						<div class="mx-auto md:mx-0 w-40 md:w-full">
							<div class="overflow-hidden ring-1 ring-ink/10">
								{cover ? (
									<img src={cover} alt={`Cover of ${title}`} class="w-full h-auto block" />
								) : (
									<div class="w-full aspect-[2/3] bg-paper-sunk flex items-center justify-center">
										<span class="font-display text-mist text-3xl">冊</span>
									</div>
								)}
							</div>
						</div>

						<div class="space-y-5">
							<p class="eyebrow text-moss">{t.reflection}</p>

							<h1 class="font-display text-3xl md:text-4xl leading-[1.15] text-ink">
								{title}
							</h1>

							<p class="text-lg text-ink-soft italic">
								<span class="not-italic text-mist">—</span> {author}
							</p>

							<div class="flex items-center gap-2">
								<div class="flex items-center gap-1">
									{stars.map((type) => (
										type === 'half' ? (
											<span class="relative inline-block w-4 h-4">
												<svg class="absolute inset-0 w-4 h-4 text-mist/50" fill="currentColor" viewBox="0 0 24 24">
													<path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
												</svg>
												<svg class="absolute inset-0 w-4 h-4 text-moss" fill="currentColor" viewBox="0 0 24 24" style="clip-path: inset(0 50% 0 0);">
													<path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
												</svg>
											</span>
										) : (
											<svg
												class:list={[
													"w-4 h-4",
													type === 'full' ? "text-moss fill-current" : "text-mist/50 fill-current"
												]}
												viewBox="0 0 24 24"
											>
												<path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
											</svg>
										)
									))}
								</div>
								<span class="font-display text-ink">{rating}</span>
								<span class="text-mist">/ 5</span>
							</div>

							<p class="text-base text-ink-soft leading-relaxed">
								{description}
							</p>

							<div class="flex flex-wrap items-center gap-x-4 gap-y-2 eyebrow pt-2">
								<FormattedDateTime datetime={datetime} lang={lang} />
								{tags && tags.length > 0 && (
									<>
										<span class="text-mist/60">/</span>
										<div class="flex flex-wrap gap-x-3">
											{tags.map((tag) => (
												<a
													href={getRelativeLocaleUrl(lang, `tags/${slugifyTag(tag)}`)}
													class="text-moss hover:text-rust transition-colors"
												>
													· {tag}
												</a>
											))}
										</div>
									</>
								)}
							</div>
						</div>
					</div>
				</div>

				<hr class="kintsugi" aria-hidden="true" />

				<div class="prose prose-lg max-w-none">
					<slot />
				</div>

				<hr class="kintsugi" aria-hidden="true" />

				<div class="mt-8">
					<a
						href={getRelativeLocaleUrl(lang, 'reading')}
						class="inline-flex items-center gap-2 font-display text-ink-soft hover:text-rust transition-colors group"
					>
						<svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16l-4-4m0 0l4-4m-4 4h18"></path>
						</svg>
						{t.back}
					</a>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
