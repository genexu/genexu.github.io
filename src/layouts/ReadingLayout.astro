---
import Head from "./Head.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import FormattedDateTime from "../components/FormattedDateTime.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { slugifyTag } from "../i18n/utils";

import "../styles/global.css";

const { frontmatter } = Astro.props;
const lang = Astro.currentLocale;

const { title, description, author, rating, cover, pubDate, tags } = frontmatter;
const datetime = new Date(pubDate);

// Generate star rating display
const fullStars = Math.floor(rating);
const hasHalfStar = rating % 1 !== 0;
const emptyStars = 5 - Math.ceil(rating);
const stars = Array.from({ length: 5 }, (_, i) => {
	if (i < fullStars) return 'full';
	if (i === fullStars && hasHalfStar) return 'half';
	return 'empty';
});

const breadcrumbs = {
	en: {
		home: 'Home',
		reading: 'Reading',
	},
	'zh-tw': {
		home: '首頁',
		reading: '閱讀',
	},
};

const t = breadcrumbs[lang] || breadcrumbs.en;
---

<!doctype html>
<html lang={lang}>
	<head>
		<Head title={title} description={description} />
	</head>
	<body class="min-h-screen text-slate-700 dark:text-slate-200 bg-gradient-to-br from-slate-50 via-white to-slate-50 dark:from-slate-950 dark:via-slate-900 dark:to-slate-950">
		<Header />
		<main class="container mx-auto px-4 md:px-6 lg:px-8">
			<article class="max-w-6xl mx-auto py-8 md:py-12" data-pagefind-body>
				<!-- Breadcrumbs -->
				<nav class="flex items-center space-x-2 text-sm text-slate-500 dark:text-slate-400 mb-8">
					<a href={getRelativeLocaleUrl(lang, '')} class="hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
						{t.home}
					</a>
					<span>/</span>
					<a href={getRelativeLocaleUrl(lang, 'reading')} class="hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
						{t.reading}
					</a>
					<span>/</span>
					<span class="text-slate-700 dark:text-slate-300 truncate">{title}</span>
				</nav>

				<!-- Hero Section with Book Info -->
				<div class="mb-12 pb-12 border-b border-slate-200 dark:border-slate-800">
					<div class="grid grid-cols-1 lg:grid-cols-[300px_1fr] gap-8 lg:gap-12">
						<!-- Book Cover -->
						<div class="flex justify-center lg:justify-start">
							<div class="relative w-full max-w-[300px] aspect-[2/3] rounded-xl overflow-hidden shadow-2xl ring-1 ring-slate-900/10 dark:ring-white/10">
								{cover ? (
									<img
										src={cover}
										alt={`Cover of ${title}`}
										class="w-full h-full object-cover"
									/>
								) : (
									<div class="w-full h-full bg-gradient-to-br from-accent-100 to-accent-200 dark:from-accent-900/30 dark:to-accent-800/30 flex items-center justify-center">
										<svg class="w-20 h-20 text-accent-400 dark:text-accent-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
										</svg>
									</div>
								)}
							</div>
						</div>

						<!-- Book & Reflection Details -->
						<div class="space-y-6">
							<!-- Book Title & Author -->
							<div class="space-y-2">
								<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-accent-100 dark:bg-accent-900/30 text-accent-700 dark:text-accent-300 border border-accent-200 dark:border-accent-700">
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
									</svg>
									Book
								</div>
								<h1 class="text-4xl md:text-5xl font-bold tracking-tight text-slate-900 dark:text-white leading-tight">
									{title}
								</h1>
								<p class="text-xl text-slate-600 dark:text-slate-400 flex items-center gap-2">
									<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
									</svg>
									{author}
								</p>
							</div>

							<!-- Rating -->
							<div class="flex items-center gap-2">
								<div class="flex items-center gap-1">
									{stars.map((type, index) => (
										type === 'half' ? (
											<div class="relative w-6 h-6">
												<!-- Empty star background -->
												<svg
													class="absolute inset-0 w-6 h-6 text-slate-300 dark:text-slate-600"
													fill="currentColor"
													viewBox="0 0 24 24"
												>
													<path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
												</svg>
												<!-- Half star overlay -->
												<svg
													class="absolute inset-0 w-6 h-6 text-yellow-400"
													fill="currentColor"
													viewBox="0 0 24 24"
													style="clip-path: inset(0 50% 0 0);"
												>
													<path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
												</svg>
											</div>
										) : (
											<svg
												class:list={[
													"w-6 h-6",
													type === 'full' ? "text-yellow-400 fill-current" : "text-slate-300 dark:text-slate-600 fill-current"
												]}
												viewBox="0 0 24 24"
											>
												<path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
											</svg>
										)
									))}
								</div>
								<span class="text-2xl font-bold text-slate-900 dark:text-white">
									{rating}
								</span>
								<span class="text-slate-500 dark:text-slate-400">
									/ 5
								</span>
							</div>

							<!-- Reflection Description -->
							<div class="space-y-3">
								<h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
									Reading Reflection
								</h2>
								<p class="text-lg text-slate-700 dark:text-slate-300 leading-relaxed">
									{description}
								</p>
							</div>

							<!-- Metadata -->
							<div class="flex flex-wrap items-center gap-4 text-sm pt-4 border-t border-slate-200 dark:border-slate-700">
								<div class="flex items-center gap-2 text-slate-500 dark:text-slate-400">
									<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
									</svg>
									<FormattedDateTime datetime={datetime} lang={lang} />
								</div>

								{tags && tags.length > 0 && (
									<div class="flex flex-wrap gap-2">
										{tags.map((tag) => (
											<a href={getRelativeLocaleUrl(lang, `tags/${slugifyTag(tag)}`)} class="group">
												<span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-accent-50 dark:bg-accent-900/30 text-accent-700 dark:text-accent-300 border border-accent-200 dark:border-accent-700 hover:bg-accent-100 dark:hover:bg-accent-900/50 transition-colors">
													#{tag}
												</span>
											</a>
										))}
									</div>
								)}
							</div>
						</div>
					</div>
				</div>

				<!-- Content -->
				<div
					class="prose prose-lg prose-slate dark:prose-invert max-w-none
					prose-headings:font-bold prose-headings:tracking-tight
					prose-h1:text-4xl prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-6 prose-h2:pb-3 prose-h2:border-b prose-h2:border-slate-200 dark:prose-h2:border-slate-800
					prose-h3:text-2xl prose-h3:mt-8 prose-h3:mb-4
					prose-p:leading-relaxed prose-p:text-slate-700 dark:prose-p:text-slate-300
					prose-a:text-accent-600 dark:prose-a:text-accent-400 prose-a:no-underline prose-a:font-medium hover:prose-a:underline
					prose-strong:text-slate-900 dark:prose-strong:text-white prose-strong:font-semibold
					prose-code:text-accent-700 dark:prose-code:text-accent-300 prose-code:font-mono prose-code:text-sm
					prose-pre:bg-slate-900 dark:prose-pre:bg-slate-950 prose-pre:border prose-pre:border-slate-700
					prose-img:rounded-xl prose-img:shadow-lg prose-img:mx-auto
					prose-blockquote:border-l-4 prose-blockquote:border-accent-500 prose-blockquote:bg-slate-50 dark:prose-blockquote:bg-slate-800/50 prose-blockquote:py-3 prose-blockquote:px-6 prose-blockquote:not-italic
					prose-blockquote:text-slate-700 dark:prose-blockquote:text-slate-300
					prose-ul:list-disc prose-ol:list-decimal
					prose-li:text-slate-700 dark:prose-li:text-slate-300 prose-li:my-1
					prose-hr:border-slate-200 dark:prose-hr:border-slate-800 prose-hr:my-12"
				>
					<slot />
				</div>

				<!-- Back Navigation -->
				<div class="mt-16 pt-8 border-t border-slate-200 dark:border-slate-800">
					<a
						href={getRelativeLocaleUrl(lang, 'reading')}
						class="inline-flex items-center gap-2 text-accent-600 dark:text-accent-400 hover:text-accent-700 dark:hover:text-accent-300 font-medium group"
					>
						<svg class="w-5 h-5 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"></path>
						</svg>
						{lang === 'zh-tw' ? '返回閱讀列表' : 'Back to Reading'}
					</a>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
