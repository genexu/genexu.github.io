---
import { getRelativeLocaleUrl } from "astro:i18n";
import ThemeToggle from "../components/ThemeToggle.astro";
import LanguageSwitch from "../components/LanguageSwitch.astro";
import { Icon } from "astro-icon/components";

const lang = Astro.currentLocale;
const home = getRelativeLocaleUrl(lang, '');

const navItems = {
	en: [
		{ path: "blog", label: "Blog" },
		{ path: "life", label: "Life" },
		{ path: "reading", label: "Reading" },
		{ path: "notes", label: "Notes" },
	],
	"zh-tw": [
		{ path: "blog", label: "文章" },
		{ path: "life", label: "生活" },
		{ path: "reading", label: "閱讀" },
		{ path: "notes", label: "筆記" },
	],
};

const navConfig = navItems[lang] || navItems.en;
const nav = navConfig.map(item => ({
	href: getRelativeLocaleUrl(lang, item.path),
	label: item.label
}));

const normalizePath = (path: string) => path.endsWith('/') && path !== '/' ? path.slice(0, -1) : path;

const buildCurrentPath = () => {
	const pathname = Astro.url.pathname;
	if (lang === 'en') {
		return normalizePath(pathname);
	}
	if (!pathname.startsWith(`/${lang}/`)) {
		return normalizePath(`/${lang}${pathname}`);
	}
	return normalizePath(pathname);
};

const currentPath = buildCurrentPath();

const socialLinks = [
	{ href: "https://github.com/genexu", icon: "mdi:github", label: "GitHub" },
	{ href: "https://www.linkedin.com/in/gene-xu-05ab99139/", icon: "mdi:linkedin", label: "LinkedIn" },
	{ href: "mailto:genexu1117.dev@gmail.com", icon: "mdi:email", label: "Email" },
	{ href: `/rss.xml`, icon: "mdi:rss", label: "RSS" },
];
---

<header class="w-full border-b border-mist/40">
	<nav class="container mx-auto px-6 md:px-10 lg:px-12 py-6">
		<div class="flex items-center justify-between gap-6">
			<a href={home} class="flex items-center gap-3 group" aria-label="Home">
				<!-- Hanko-style seal: 徐 in an ink ring. -->
				<span class="inline-flex items-center justify-center w-9 h-9 rounded-full border border-rust text-rust group-hover:bg-rust/10 transition-colors">
					<span class="font-display text-base leading-none">G</span>
				</span>
			</a>

			<div class="hidden md:flex items-center gap-6">
				{nav.map((item) => {
					const normalizedHref = normalizePath(item.href);
					const isActive = currentPath === normalizedHref || currentPath.startsWith(normalizedHref + '/');
					return (
						<a
							href={item.href}
							class:list={[
								"font-display text-base transition-colors relative",
								isActive
									? "text-ink"
									: "text-ink-soft hover:text-ink"
							]}
						>
							{item.label}
							{isActive && (
								<span class="absolute -bottom-1 left-0 right-0 h-px bg-moss"></span>
							)}
						</a>
					);
				})}
			</div>

			<div class="flex items-center gap-3">
				<div class="hidden md:flex items-center gap-2">
					{socialLinks.map((link) => (
						<a
							href={link.href}
							target={link.href.startsWith('http') ? '_blank' : undefined}
							rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
							class="p-1.5 text-mist hover:text-rust transition-colors"
							aria-label={link.label}
						>
							<Icon name={link.icon} width={18} height={18} />
						</a>
					))}
				</div>
				<span class="hidden md:inline-block w-px h-4 bg-mist/50"></span>
				<LanguageSwitch />
				<ThemeToggle />
			</div>
		</div>
	</nav>
</header>
